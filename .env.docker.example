# ---------------------------------------------------------------------------
# pm2-monitor SERVER (hub) mode — Docker env reference.
# Copy to `.env` (next to docker-compose.yml) and edit. Do NOT commit `.env`.
# Values marked CHANGE_ME are placeholders — replace them with real secrets.
# ---------------------------------------------------------------------------

# --- Run mode ---
# server — accepts agents and serves the fleet dashboard.
MODE=server

# --- HTTP + WebSocket server ---
# Bind address. MUST be 0.0.0.0 inside a container so the port is reachable.
HOST=0.0.0.0
# Port the HTTP + WS server listens on (matches the compose port mapping).
PORT=3000

# --- Authentication ---
# Auth strategy: "apikey" (shared key) or "basic" (user/pass).
AUTH_MODE=apikey
# Shared API key. REQUIRED when AUTH_MODE=apikey.
# Sent by clients as `X-API-Key: <key>` or `Authorization: Bearer <key>`.
API_KEY=CHANGE_ME_long_random
# Basic-auth credentials. REQUIRED when AUTH_MODE=basic (otherwise ignored).
# BASIC_USER=admin
# BASIC_PASS=CHANGE_ME

# --- Server mode (agents) ---
# Comma-separated list of valid agent tokens (redacted from all logs).
# REQUIRED in server mode. Each agent presents one of these as its AGENT_TOKEN.
AGENT_TOKENS=CHANGE_ME_token_a,CHANGE_ME_token_b
# Agent-facing WS path. MUST NOT be /ws (the human dashboard path).
AGENT_WS_PATH=/agent
# Where operator-set agent aliases are persisted (JSON). Keep this on the
# mounted /app/config volume so aliases survive container restarts.
ALIAS_STORE_FILE=/app/config/agent-aliases.json

# --- Alert rules ---
# Optional JSON rules file. If absent, monitoring runs with no rules.
ALERT_RULES_FILE=config/alert-rules.json

# --- Metrics ---
# How long (minutes) to retain per-process CPU/memory samples.
METRICS_RETENTION_MIN=180
# Poll interval (seconds) for metrics + the process list refresh.
METRICS_SAMPLE_SEC=5

# --- Error capture ---
# Ring-buffer capacity (distinct error signatures) kept per process.
ERROR_BUFFER_SIZE=500
# Append each captured error as one JSON line to logs/errors.log (best-effort).
ERROR_LOG_APPEND=false

# --- Alerting behavior ---
# Default per-rule anti-spam cooldown (seconds) when a rule omits cooldownSec.
DEFAULT_COOLDOWN_SEC=300
# Base grace window (ms) for operator-initiated stop/restart/delete tokens.
INTENTIONAL_ACTION_GRACE_MS=10000

# --- Daily digest (email-only summary) ---
# Enable the daily digest email. Requires the email channel to be configured.
DIGEST_ENABLED=false
# Local hour (0-23) to send the digest.
DIGEST_HOUR=8

# --- Logging ---
# Log level: debug | info | warn | error.
LOG_LEVEL=info

# --- Email (SMTP) alert channel (optional) ---
# The email channel is enabled only when the full group below is present.
# Leave commented to run Teams-only (or with no email).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alerts@example.com
# SMTP_PASS=CHANGE_ME
# MAIL_FROM=alerts@example.com
# MAIL_TO=oncall@example.com,ops@example.com

# --- Microsoft Teams alert channel (optional) ---
# Incoming-webhook URL (redacted from all logs). Leave commented to disable.
# TEAMS_WEBHOOK_URL=CHANGE_ME_teams_webhook_url

# --- Native TLS (optional) ---
# Set BOTH to terminate TLS in-process (https). Leave BOTH blank/commented to
# terminate TLS at a reverse proxy (the common setup) and serve plain http here.
# Setting only one is a config error. Mount ./certs:/app/certs:ro in compose.
# TLS_CERT_FILE=/app/certs/fullchain.pem
# TLS_KEY_FILE=/app/certs/privkey.pem
