# ---------------------------------------------------------------------------
# pm2-monitor configuration. Copy to `.env` and edit. Do NOT commit `.env`.
# Every variable the app reads is documented here. Values shown are examples
# or defaults — never real secrets.
# ---------------------------------------------------------------------------

# --- HTTP + WebSocket server ---
# Port the HTTP + WS server listens on.
PORT=3000
# Bind address. 127.0.0.1 keeps it local-only; set 0.0.0.0 to expose it.
HOST=127.0.0.1

# --- Authentication ---
# Auth strategy: "apikey" (shared key) or "basic" (user/pass).
AUTH_MODE=apikey
# Shared API key. REQUIRED when AUTH_MODE=apikey.
# Sent by clients as `X-API-Key: <key>` or `Authorization: Bearer <key>`.
API_KEY=change-me-to-a-long-random-string
# Basic-auth username. REQUIRED when AUTH_MODE=basic.
BASIC_USER=admin
# Basic-auth password. REQUIRED when AUTH_MODE=basic.
BASIC_PASS=change-me

# --- Email (SMTP) alert channel ---
# The email channel is "enabled" only when the full group below is present;
# leave them blank to run Teams-only (or with no email).
SMTP_HOST=smtp.example.com
# SMTP port (default 587).
SMTP_PORT=587
# Use TLS-on-connect (true for port 465, usually false for 587 + STARTTLS).
SMTP_SECURE=false
SMTP_USER=alerts@example.com
# SMTP password (redacted from all logs).
SMTP_PASS=change-me
# From address on alert/digest emails.
MAIL_FROM=alerts@example.com
# Comma-separated recipient list.
MAIL_TO=oncall@example.com,ops@example.com

# --- Microsoft Teams alert channel ---
# Incoming-webhook URL (redacted from all logs). Leave blank to disable Teams.
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-id

# --- Alert rules ---
# Optional JSON rules file. If absent, monitoring runs with no rules.
# See config/alert-rules.example.json for the schema.
ALERT_RULES_FILE=config/alert-rules.json

# --- Metrics ---
# How long (minutes) to retain per-process CPU/memory samples.
METRICS_RETENTION_MIN=180
# Poll interval (seconds) for metrics + the process list refresh.
METRICS_SAMPLE_SEC=5

# --- Error capture ---
# Ring-buffer capacity (distinct error signatures) kept per process.
ERROR_BUFFER_SIZE=500
# Append each captured error as one JSON line to logs/errors.log (best-effort).
ERROR_LOG_APPEND=false

# --- Alerting behavior ---
# Default per-rule anti-spam cooldown (seconds) when a rule omits cooldownSec.
DEFAULT_COOLDOWN_SEC=300
# Base grace window (ms) for operator-initiated stop/restart/delete tokens;
# a process's kill_timeout is added on top when PM2 reports it.
INTENTIONAL_ACTION_GRACE_MS=10000
# Optional prefix that start-new script/ecosystem paths must live under
# (defense in depth; off by default). Leave blank to allow any absolute path.
ALLOWED_SCRIPT_ROOT=

# --- Daily digest (email-only summary) ---
# Enable the daily digest email. Requires the email channel to be configured.
DIGEST_ENABLED=false
# Local hour (0-23) to send the digest.
DIGEST_HOUR=8

# --- Logging ---
# Log level: debug | info | warn | error.
LOG_LEVEL=info
