{
  "name": "pm2-monitor",
  "version": "1.0.0",
  "description": "PM2 process monitor and control panel with MS Teams/email alerts, a live dashboard, and error capture.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "4.22.3",
    "ws": "8.22.0",
    "pm2": "5.4.3",
    "nodemailer": "6.10.1",
    "dotenv": "16.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "20.19.43",
    "@types/express": "4.17.25",
    "@types/ws": "8.18.2",
    "@types/nodemailer": "6.4.24"
  }
}
